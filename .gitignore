# ── Data files (large CSVs — do not commit) ──────────────────────────────────
data/
*.csv
!results/tables/*.csv

# ── Model checkpoints (large binaries) ───────────────────────────────────────
models/
*.pt
*.pth
*.pkl
*.joblib

# ── XGBoost model output ──────────────────────────────────────────────────────
*.json
!package.json
!package-lock.json

# ── Intermediate VAE inference outputs (regenerated by running notebooks) ─────
vae_anomaly_test_results*.csv
vae_evt_anomaly_labels.csv
xcs_results_per_anomaly.csv
shap_explanations_per_anomaly.csv

# ── Jupyter Notebook checkpoints ─────────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
.conda/

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── PDF figures (large — PNGs committed instead) ─────────────────────────────
results/figures/*.pdf

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
